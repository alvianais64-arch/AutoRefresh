{
  "manifest_version": 3,
  "name": "Auto Refresh Pro",
  "version": "1.0.0",
  "description": "Modern Auto Refresh & Auto Scroll Extension",

  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "activeTab"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "options_page": "options.html",

  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}
